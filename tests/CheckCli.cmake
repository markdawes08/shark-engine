cmake_minimum_required(VERSION 3.28)
foreach(shark_mode IN ITEMS version help default invalid extra)
    set(shark_args "")
    set(shark_expected_exit 0)
    if(shark_mode STREQUAL "version")
        set(shark_args --version)
    elseif(shark_mode STREQUAL "help")
        set(shark_args --help)
    elseif(shark_mode STREQUAL "invalid")
        set(shark_args --launch)
        set(shark_expected_exit 2)
    elseif(shark_mode STREQUAL "extra")
        set(shark_args --version --help)
        set(shark_expected_exit 2)
    endif()
    execute_process(COMMAND "${SHARK_EXECUTABLE}" ${shark_args}
        RESULT_VARIABLE shark_result OUTPUT_VARIABLE shark_output ERROR_VARIABLE shark_error
        TIMEOUT 5)
    if(NOT "${shark_result}" STREQUAL "${shark_expected_exit}")
        message(FATAL_ERROR "${SHARK_APPLICATION} ${shark_mode}: exit ${shark_result}, expected ${shark_expected_exit}; ${shark_error}")
    endif()
    string(REPLACE "\r\n" "\n" shark_output "${shark_output}")
    string(REPLACE "\r\n" "\n" shark_error "${shark_error}")
    if(shark_mode STREQUAL "version")
        if(NOT shark_output STREQUAL "Shark ${SHARK_APPLICATION} ${SHARK_VERSION}\n" OR NOT shark_error STREQUAL "")
            message(FATAL_ERROR "Unexpected ${SHARK_APPLICATION} version output: '${shark_output}' '${shark_error}'")
        endif()
    elseif(shark_expected_exit EQUAL 0)
        if(NOT shark_output MATCHES "Usage: ${SHARK_APPLICATION}" OR
           NOT shark_output MATCHES "foundation only" OR NOT shark_output MATCHES "--graphics" OR
           NOT shark_error STREQUAL "")
            message(FATAL_ERROR "Missing honest foundation help: '${shark_output}' '${shark_error}'")
        endif()
    else()
        if(NOT shark_output STREQUAL "" OR NOT shark_error MATCHES "Usage: ${SHARK_APPLICATION}")
            message(FATAL_ERROR "Invalid arguments must report on stderr only: '${shark_output}' '${shark_error}'")
        endif()
        string(FIND "${shark_error}" "\n" shark_line_end)
        if(shark_line_end LESS 0)
            message(FATAL_ERROR "Missing structured diagnostic: '${shark_error}'")
        endif()
        string(SUBSTRING "${shark_error}" 0 ${shark_line_end} shark_diagnostic)
        foreach(shark_field IN ITEMS level code category operation message)
            string(JSON shark_value ERROR_VARIABLE shark_json_error GET "${shark_diagnostic}" ${shark_field})
            if(NOT shark_json_error STREQUAL "NOTFOUND" OR shark_value STREQUAL "")
                message(FATAL_ERROR "Missing ${shark_field} in diagnostic: '${shark_error}'")
            endif()
            if(shark_field STREQUAL "level" AND NOT shark_value STREQUAL "error" OR
               shark_field STREQUAL "code" AND NOT shark_value STREQUAL "invalid_argument" OR
               shark_field STREQUAL "category" AND NOT shark_value STREQUAL "validation" OR
               shark_field STREQUAL "operation" AND NOT shark_value STREQUAL "bootstrap.arguments.parse")
                message(FATAL_ERROR "Unexpected ${shark_field}: '${shark_value}'")
            endif()
        endforeach()
    endif()
endforeach()
