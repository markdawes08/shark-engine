# The complete pinned Mbed TLS release includes its exact TF-PSA-Crypto inputs.
include_guard(GLOBAL)

function(shark_validate_network_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_network_lock)
    string(JSON shark_sha GET "${shark_network_lock}" dependencies MbedTLS sha256)
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_MBEDTLS MBEDTLS_DIR TF_PSA_CRYPTO_SOURCE_DIR
            MBEDTLS_CONFIG_FILE TF_PSA_CRYPTO_CONFIG_FILE TF_PSA_CRYPTO_USER_CONFIG_FILE)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified network source override ${shark_override}; use SHARK_MBEDTLS_ARCHIVE")
        endif()
    endforeach()
    if(DEFINED MBEDTLS_USER_CONFIG_FILE AND NOT MBEDTLS_USER_CONFIG_FILE STREQUAL ""
            AND NOT MBEDTLS_USER_CONFIG_FILE STREQUAL "${PROJECT_SOURCE_DIR}/cmake/mbedtls_user_config.h")
        message(FATAL_ERROR "Unverified network configuration override MBEDTLS_USER_CONFIG_FILE")
    endif()
    set(SHARK_MBEDTLS_ARCHIVE "" CACHE FILEPATH "Optional exact locked Mbed TLS release archive")
    set(shark_archive "${SHARK_MBEDTLS_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/mbedtls-4.1.1.tar.bz2")
    endif()
    if(EXISTS "${shark_archive}")
        if(IS_DIRECTORY "${shark_archive}" OR IS_SYMLINK "${shark_archive}")
            message(FATAL_ERROR "SHARK_MBEDTLS_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "MbedTLS archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_MBEDTLS_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline MbedTLS population requires SHARK_MBEDTLS_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_network_dependencies)
    shark_validate_network_inputs()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_network_lock)
    string(JSON shark_sha GET "${shark_network_lock}" dependencies MbedTLS sha256)
    string(JSON shark_url GET "${shark_network_lock}" dependencies MbedTLS url)
    set(shark_archive "${SHARK_MBEDTLS_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/mbedtls-4.1.1.tar.bz2")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(NOT EXISTS "${shark_archive}")
        file(DOWNLOAD "${shark_url}" "${shark_archive}" EXPECTED_HASH "SHA256=${shark_sha}"
            TLS_VERIFY ON TIMEOUT 60 STATUS shark_download)
        list(GET shark_download 0 shark_download_code)
        if(NOT shark_download_code EQUAL 0)
            message(FATAL_ERROR "Locked MbedTLS download failed: ${shark_download}")
        endif()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/core_dependencies.py"
        --populate-network "${CMAKE_BINARY_DIR}" --archive "${shark_archive}"
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked MbedTLS source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_network_source "${CMAKE_BINARY_DIR}/_deps/mbedtls-src")
    set(SHARK_MbedTLS_SOURCE_DIR "${shark_network_source}" CACHE INTERNAL "Locked Mbed TLS source" FORCE)
    set(SHARK_MbedTLS_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked Mbed TLS archive" FORCE)
    string(JSON shark_option_count LENGTH "${shark_network_lock}" dependencies MbedTLS options)
    math(EXPR shark_option_last "${shark_option_count} - 1")
    foreach(shark_index RANGE ${shark_option_last})
        string(JSON shark_option MEMBER "${shark_network_lock}" dependencies MbedTLS options ${shark_index})
        string(JSON shark_value GET "${shark_network_lock}" dependencies MbedTLS options "${shark_option}")
        set(${shark_option} "${shark_value}" CACHE BOOL "Reviewed Mbed TLS option" FORCE)
    endforeach()
    set(MBEDTLS_TARGET_PREFIX "SharkTLS_" CACHE STRING "Private Mbed TLS target prefix" FORCE)
    set(TF_PSA_CRYPTO_TARGET_PREFIX "SharkTLS_" CACHE STRING "Private TF PSA target prefix" FORCE)
    set(MBEDTLS_USER_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/mbedtls_user_config.h" CACHE STRING "Shark TLS record limits" FORCE)
    add_subdirectory("${shark_network_source}" "${CMAKE_BINARY_DIR}/_deps/mbedtls-build" EXCLUDE_FROM_ALL SYSTEM)
    set(shark_network_targets mbedtls mbedx509 tfpsacrypto builtin everest p256-m pqcp extras platform utilities)
    foreach(shark_name IN LISTS shark_network_targets)
        shark_classify_target("SharkTLS_${shark_name}" core)
        shark_enable_sanitizers("SharkTLS_${shark_name}")
    endforeach()
    # The upstream static crypto library embeds only these reviewed object targets.
    foreach(shark_name IN ITEMS builtin everest p256-m pqcp extras platform utilities)
        add_dependencies(SharkTLS_tfpsacrypto "SharkTLS_${shark_name}")
    endforeach()
    if(WIN32)
        foreach(shark_system IN ITEMS ws2_32 bcrypt)
            find_library(SHARK_TLS_${shark_system}_LIBRARY NAMES ${shark_system} REQUIRED)
            add_library(SharkTLS_${shark_system} STATIC IMPORTED GLOBAL)
            set_target_properties(SharkTLS_${shark_system} PROPERTIES IMPORTED_LOCATION "${SHARK_TLS_${shark_system}_LIBRARY}")
            shark_classify_target(SharkTLS_${shark_system} core)
        endforeach()
        # Replace the upstream raw system-library names with classified imports.
        set_property(TARGET SharkTLS_tfpsacrypto PROPERTY LINK_LIBRARIES "SharkTLS_ws2_32;SharkTLS_bcrypt")
        set_property(TARGET SharkTLS_tfpsacrypto PROPERTY INTERFACE_LINK_LIBRARIES "SharkTLS_ws2_32;SharkTLS_bcrypt")
    endif()
    if(SHARK_BUILD_SERVER)
        string(JSON shark_license_count LENGTH "${shark_network_lock}" dependencies MbedTLS license_files)
        math(EXPR shark_license_last "${shark_license_count} - 1")
        foreach(shark_index RANGE ${shark_license_last})
            string(JSON shark_license GET "${shark_network_lock}" dependencies MbedTLS license_files ${shark_index})
            cmake_path(GET shark_license PARENT_PATH shark_license_parent)
            install(FILES "${shark_network_source}/${shark_license}"
                DESTINATION "licenses/MbedTLS/${shark_license_parent}" COMPONENT Server)
        endforeach()
    endif()
endfunction()
