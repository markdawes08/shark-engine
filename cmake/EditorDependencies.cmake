# Dear ImGui is private to the native Editor; upstream backends/builds never run.
include_guard(GLOBAL)

function(shark_validate_editor_inputs)
    if(NOT SHARK_BUILD_EDITOR OR NOT SHARK_NATIVE_GRAPHICS)
        return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_editor_lock)
    string(JSON shark_sha GET "${shark_editor_lock}" dependencies ImGui sha256)
    string(LENGTH "${shark_sha}" shark_sha_length)
    if(NOT shark_sha_length EQUAL 64 OR NOT shark_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "ImGui must have an exact SHA-256 archive pin")
    endif()
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_IMGUI imgui_DIR IMGUI_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified ImGui source override ${shark_override}; use SHARK_IMGUI_ARCHIVE")
        endif()
    endforeach()
    string(JSON shark_commit GET "${shark_editor_lock}" dependencies ImGui commit)
    string(JSON shark_archive_bytes GET "${shark_editor_lock}" dependencies ImGui archive_bytes)
    set(SHARK_IMGUI_ARCHIVE "" CACHE FILEPATH "Optional exact locked Dear ImGui source archive")
    set(shark_archive "${SHARK_IMGUI_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${PROJECT_SOURCE_DIR}/.tools/dependency-archives/imgui-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(IS_SYMLINK "${shark_archive}" OR IS_DIRECTORY "${shark_archive}")
        message(FATAL_ERROR "SHARK_IMGUI_ARCHIVE must name a regular locked archive")
    elseif(EXISTS "${shark_archive}")
        file(SIZE "${shark_archive}" shark_actual_bytes)
        if(NOT shark_actual_bytes EQUAL shark_archive_bytes)
            message(FATAL_ERROR "ImGui archive size differs from the dependency lock")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "ImGui archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_IMGUI_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline ImGui population requires SHARK_IMGUI_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_editor_dependencies)
    if(NOT SHARK_BUILD_EDITOR OR NOT SHARK_NATIVE_GRAPHICS)
        return()
    endif()
    shark_validate_editor_inputs()
    if(TARGET SharkImGui OR TARGET Shark::ImGui OR TARGET imgui)
        message(FATAL_ERROR "ImGui target already exists outside the reviewed Editor integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_editor_lock)
    string(JSON shark_commit GET "${shark_editor_lock}" dependencies ImGui commit)
    set(shark_archive "${SHARK_IMGUI_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${PROJECT_SOURCE_DIR}/.tools/dependency-archives/imgui-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(shark_download_args "")
    if(NOT EXISTS "${shark_archive}")
        list(APPEND shark_download_args --download)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/editor_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}" ${shark_download_args}
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked ImGui source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_imgui_source "${CMAKE_BINARY_DIR}/_deps/imgui-src")
    set(SHARK_IMGUI_SOURCE_DIR "${shark_imgui_source}" CACHE INTERNAL "Locked Editor-only ImGui source directory" FORCE)
    set(SHARK_IMGUI_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked ImGui source archive" FORCE)
    add_library(SharkImGui STATIC
        "${shark_imgui_source}/imgui.cpp"
        "${shark_imgui_source}/imgui_draw.cpp"
        "${shark_imgui_source}/imgui_tables.cpp"
        "${shark_imgui_source}/imgui_widgets.cpp")
    add_library(Shark::ImGui ALIAS SharkImGui)
    target_include_directories(SharkImGui SYSTEM PUBLIC "${shark_imgui_source}")
    target_compile_features(SharkImGui PUBLIC cxx_std_20)
    set_target_properties(SharkImGui PROPERTIES CXX_EXTENSIONS OFF)
    target_compile_definitions(SharkImGui PUBLIC
        IMGUI_DISABLE_FILE_FUNCTIONS=1
        IMGUI_DISABLE_DEFAULT_SHELL_FUNCTIONS=1
        IMGUI_DISABLE_WIN32_DEFAULT_IME_FUNCTIONS=1)
    if(MSVC)
        target_compile_options(SharkImGui PRIVATE /utf-8 /EHsc)
    endif()
    shark_enable_sanitizers(SharkImGui)
    shark_classify_target(SharkImGui authoring)
    shark_classify_target(Shark::ImGui authoring)
endfunction()
