# stb_image belongs exclusively to EngineTools; upstream build files never execute.
include_guard(GLOBAL)

function(shark_validate_image_inputs)
    if(NOT SHARK_BUILD_TOOLS)
        return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_image_lock)
    string(JSON shark_sha GET "${shark_image_lock}" dependencies stb_image sha256)
    string(LENGTH "${shark_sha}" shark_sha_length)
    if(NOT shark_sha_length EQUAL 64 OR NOT shark_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "stb_image must have an exact SHA-256 archive pin")
    endif()
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_STB_IMAGE FETCHCONTENT_SOURCE_DIR_STB stb_image_DIR STB_IMAGE_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified stb_image source override ${shark_override}; use SHARK_IMAGE_ARCHIVE")
        endif()
    endforeach()
    string(JSON shark_commit GET "${shark_image_lock}" dependencies stb_image commit)
    string(JSON shark_archive_bytes GET "${shark_image_lock}" dependencies stb_image archive_bytes)
    set(SHARK_IMAGE_ARCHIVE "" CACHE FILEPATH "Optional exact locked stb_image source archive")
    set(shark_archive "${SHARK_IMAGE_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/stb-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(IS_SYMLINK "${shark_archive}" OR IS_DIRECTORY "${shark_archive}")
        message(FATAL_ERROR "SHARK_IMAGE_ARCHIVE must name a regular locked archive")
    elseif(EXISTS "${shark_archive}")
        file(SIZE "${shark_archive}" shark_actual_bytes)
        if(NOT shark_actual_bytes EQUAL shark_archive_bytes)
            message(FATAL_ERROR "stb_image archive size differs from the dependency lock")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "stb_image archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_IMAGE_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline stb_image population requires SHARK_IMAGE_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_image_dependencies)
    if(NOT SHARK_BUILD_TOOLS)
        return()
    endif()
    shark_validate_image_inputs()
    if(TARGET SharkStbImage OR TARGET Shark::StbImage OR TARGET stb_image)
        message(FATAL_ERROR "stb_image target already exists outside the reviewed authoring integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_image_lock)
    string(JSON shark_sha GET "${shark_image_lock}" dependencies stb_image sha256)
    string(JSON shark_url GET "${shark_image_lock}" dependencies stb_image url)
    string(JSON shark_commit GET "${shark_image_lock}" dependencies stb_image commit)
    set(shark_archive "${SHARK_IMAGE_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/stb-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(shark_download_args "")
    if(NOT EXISTS "${shark_archive}")
        list(APPEND shark_download_args --download)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/image_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}" ${shark_download_args}
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked stb_image source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_stb_image_source "${CMAKE_BINARY_DIR}/_deps/stb_image-src")
    set(SHARK_IMAGE_SOURCE_DIR "${shark_stb_image_source}" CACHE INTERNAL "Locked private stb_image source directory" FORCE)
    set(SHARK_IMAGE_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked stb_image source archive" FORCE)
    add_library(SharkStbImage INTERFACE)
    add_library(Shark::StbImage ALIAS SharkStbImage)
    target_include_directories(SharkStbImage SYSTEM INTERFACE "${shark_stb_image_source}")
    shark_classify_target(SharkStbImage authoring)
    shark_classify_target(Shark::StbImage authoring)
endfunction()
