# Lua is a private, pinned C implementation dependency of Core.
include_guard(GLOBAL)

function(shark_validate_lua_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_LUA LUA_DIR LUA_INCLUDE_DIR LUA_LIBRARY LUA_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified Lua source override ${shark_override}; use SHARK_LUA_ARCHIVE")
        endif()
    endforeach()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_lua_lock)
    string(JSON shark_sha GET "${shark_lua_lock}" dependencies Lua sha256)
    set(SHARK_LUA_ARCHIVE "" CACHE FILEPATH "Optional exact locked Lua archive")
    set(shark_archive "${SHARK_LUA_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_canonical "${PROJECT_SOURCE_DIR}/out/dependency-cache/lua-5.5.1.tar.gz")
        if(EXISTS "${shark_canonical}")
            set(shark_archive "${shark_canonical}")
        else()
            set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/lua-5.5.1.tar.gz")
        endif()
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(EXISTS "${shark_archive}")
        if(IS_DIRECTORY "${shark_archive}" OR IS_SYMLINK "${shark_archive}")
            message(FATAL_ERROR "SHARK_LUA_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "Lua archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_LUA_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline Lua population requires SHARK_LUA_ARCHIVE or its prior locked archive cache")
    endif()
    set(SHARK_LUA_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked Lua archive" FORCE)
endfunction()

function(shark_setup_lua_dependencies)
    shark_validate_lua_inputs()
    if(TARGET SharkLua)
        message(FATAL_ERROR "Lua target already exists outside reviewed Core integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_lua_lock)
    string(JSON shark_sha GET "${shark_lua_lock}" dependencies Lua sha256)
    string(JSON shark_url GET "${shark_lua_lock}" dependencies Lua url)
    set(shark_archive "${SHARK_LUA_ARCHIVE_INPUT}")
    if(NOT EXISTS "${shark_archive}")
        get_filename_component(shark_archive_dir "${shark_archive}" DIRECTORY)
        file(MAKE_DIRECTORY "${shark_archive_dir}")
        file(DOWNLOAD "${shark_url}" "${shark_archive}" EXPECTED_HASH "SHA256=${shark_sha}"
            TLS_VERIFY ON TIMEOUT 60 STATUS shark_download)
        list(GET shark_download 0 shark_download_code)
        if(NOT shark_download_code EQUAL 0)
            message(FATAL_ERROR "Locked Lua download failed: ${shark_download}")
        endif()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/lua_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}"
        RESULT_VARIABLE shark_status OUTPUT_VARIABLE shark_output ERROR_VARIABLE shark_error)
    if(NOT shark_status EQUAL 0)
        message(FATAL_ERROR "Locked Lua source verification failed: ${shark_output}${shark_error}")
    endif()
    set(shark_source "${CMAKE_BINARY_DIR}/_deps/lua-src")
    set(SHARK_LUA_SOURCE_DIR "${shark_source}" CACHE INTERNAL "Locked Lua source" FORCE)
    string(JSON shark_count LENGTH "${shark_lua_lock}" dependencies Lua sources)
    math(EXPR shark_last "${shark_count} - 1")
    set(shark_sources "")
    foreach(shark_index RANGE ${shark_last})
        string(JSON shark_file GET "${shark_lua_lock}" dependencies Lua sources ${shark_index})
        list(APPEND shark_sources "${shark_source}/src/${shark_file}")
    endforeach()
    add_library(SharkLua STATIC ${shark_sources})
    target_include_directories(SharkLua SYSTEM PUBLIC "${shark_source}/src")
    set_target_properties(SharkLua PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO
        DISABLE_PRECOMPILE_HEADERS ON UNITY_BUILD OFF INTERPROCEDURAL_OPTIMIZATION OFF)
    if(MSVC)
        set_property(TARGET SharkLua PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
    shark_enable_sanitizers(SharkLua)
    shark_classify_target(SharkLua core)
    if(SHARK_BUILD_SERVER)
        install(FILES "${shark_source}/doc/readme.html" DESTINATION licenses/Lua/doc COMPONENT Server)
    endif()
endfunction()
