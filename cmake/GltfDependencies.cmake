# cgltf belongs exclusively to EngineTools; upstream build files never execute.
include_guard(GLOBAL)

function(shark_validate_gltf_inputs)
    if(NOT SHARK_BUILD_TOOLS)
        return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_gltf_lock)
    string(JSON shark_sha GET "${shark_gltf_lock}" dependencies cgltf sha256)
    string(LENGTH "${shark_sha}" shark_sha_length)
    if(NOT shark_sha_length EQUAL 64 OR NOT shark_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "cgltf must have an exact SHA-256 archive pin")
    endif()
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_CGLTF cgltf_DIR CGLTF_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified cgltf source override ${shark_override}; use SHARK_CGLTF_ARCHIVE")
        endif()
    endforeach()
    string(JSON shark_commit GET "${shark_gltf_lock}" dependencies cgltf commit)
    string(JSON shark_archive_bytes GET "${shark_gltf_lock}" dependencies cgltf archive_bytes)
    set(SHARK_CGLTF_ARCHIVE "" CACHE FILEPATH "Optional exact locked cgltf source archive")
    set(shark_archive "${SHARK_CGLTF_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/cgltf-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(IS_SYMLINK "${shark_archive}" OR IS_DIRECTORY "${shark_archive}")
        message(FATAL_ERROR "SHARK_CGLTF_ARCHIVE must name a regular locked archive")
    elseif(EXISTS "${shark_archive}")
        file(SIZE "${shark_archive}" shark_actual_bytes)
        if(NOT shark_actual_bytes EQUAL shark_archive_bytes)
            message(FATAL_ERROR "cgltf archive size differs from the dependency lock")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "cgltf archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_CGLTF_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline cgltf population requires SHARK_CGLTF_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_gltf_dependencies)
    if(NOT SHARK_BUILD_TOOLS)
        return()
    endif()
    shark_validate_gltf_inputs()
    if(TARGET SharkCgltf OR TARGET Shark::Cgltf OR TARGET cgltf)
        message(FATAL_ERROR "cgltf target already exists outside the reviewed authoring integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_gltf_lock)
    string(JSON shark_sha GET "${shark_gltf_lock}" dependencies cgltf sha256)
    string(JSON shark_url GET "${shark_gltf_lock}" dependencies cgltf url)
    string(JSON shark_commit GET "${shark_gltf_lock}" dependencies cgltf commit)
    set(shark_archive "${SHARK_CGLTF_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/cgltf-${shark_commit}.tar.gz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(shark_download_args "")
    if(NOT EXISTS "${shark_archive}")
        list(APPEND shark_download_args --download)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/gltf_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}" ${shark_download_args}
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked cgltf source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_cgltf_source "${CMAKE_BINARY_DIR}/_deps/cgltf-src")
    set(SHARK_CGLTF_SOURCE_DIR "${shark_cgltf_source}" CACHE INTERNAL "Locked private cgltf source directory" FORCE)
    set(SHARK_CGLTF_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked cgltf source archive" FORCE)
    add_library(SharkCgltf INTERFACE)
    add_library(Shark::Cgltf ALIAS SharkCgltf)
    target_include_directories(SharkCgltf SYSTEM INTERFACE "${shark_cgltf_source}")
    shark_classify_target(SharkCgltf authoring)
    shark_classify_target(Shark::Cgltf authoring)
endfunction()
