function(shark_validate_sanitizer)
    if(NOT SHARK_SANITIZER MATCHES "^(none|address|address-undefined)$")
        message(FATAL_ERROR "Unknown SHARK_SANITIZER '${SHARK_SANITIZER}'")
    endif()
    if(SHARK_SANITIZER STREQUAL "none")
        return()
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        if(NOT SHARK_SANITIZER STREQUAL "address")
            message(FATAL_ERROR "MSVC supports this project's address sanitizer preset only; UBSan is unavailable")
        endif()
        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "Use windows-asan (RelWithDebInfo); MSVC Debug /RTC checks conflict with ASan")
        endif()
    elseif(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$" OR WIN32)
        message(FATAL_ERROR "Sanitizers are supported with native MSVC or Unix GCC/Clang/AppleClang only")
    endif()
endfunction()

function(shark_enable_sanitizers target)
    if(SHARK_SANITIZER STREQUAL "none")
        return()
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(${target} PRIVATE /fsanitize=address)
        target_link_options(${target} PRIVATE /INCREMENTAL:NO)
    else()
        if(SHARK_SANITIZER STREQUAL "address-undefined")
            set(shark_sanitize_flag -fsanitize=address,undefined)
        else()
            set(shark_sanitize_flag -fsanitize=address)
        endif()
        target_compile_options(${target} PRIVATE ${shark_sanitize_flag} -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE ${shark_sanitize_flag} -fno-omit-frame-pointer)
    endif()
endfunction()

function(shark_configure_target target)
    target_compile_features(${target} PUBLIC cxx_std_20)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /permissive- /Zc:__cplusplus /utf-8 /EHsc)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
        target_compile_options(${target} PRIVATE
            -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
    else()
        message(FATAL_ERROR "Unsupported C++ compiler '${CMAKE_CXX_COMPILER_ID}'; add and verify its warning policy explicitly")
    endif()
    shark_enable_sanitizers(${target})
endfunction()
