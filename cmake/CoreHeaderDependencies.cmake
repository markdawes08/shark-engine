# Shared archive population for the two reviewed CPU header dependencies.
include_guard(GLOBAL)
include(FetchContent)

function(shark_validate_core_header_input name)
    if(NOT name MATCHES "^(EnTT|GLM)$")
        message(FATAL_ERROR "Unreviewed Core header dependency: ${name}")
    endif()
    string(TOUPPER "${name}" shark_upper)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_core_lock)
    string(JSON shark_schema GET "${shark_core_lock}" schema_version)
    if(NOT shark_schema EQUAL 1)
        message(FATAL_ERROR "Unsupported dependencies.lock.json schema: ${shark_schema}")
    endif()
    if(DEFINED FETCHCONTENT_SOURCE_DIR_${shark_upper} AND NOT FETCHCONTENT_SOURCE_DIR_${shark_upper} STREQUAL "")
        message(FATAL_ERROR "Unverified ${name} source overrides are disabled; use the locked archive/cache")
    endif()
    string(JSON shark_sha GET "${shark_core_lock}" dependencies "${name}" sha256)
    string(LENGTH "${shark_sha}" shark_sha_length)
    if(NOT shark_sha_length EQUAL 64 OR NOT shark_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "${name} must have an exact SHA-256 archive pin")
    endif()
    set(SHARK_${shark_upper}_ARCHIVE "" CACHE FILEPATH "Optional local ${name} archive; must match the dependency lock")
    if(NOT SHARK_${shark_upper}_ARCHIVE STREQUAL "")
        if(NOT EXISTS "${SHARK_${shark_upper}_ARCHIVE}" OR IS_DIRECTORY "${SHARK_${shark_upper}_ARCHIVE}"
                OR IS_SYMLINK "${SHARK_${shark_upper}_ARCHIVE}")
            message(FATAL_ERROR "SHARK_${shark_upper}_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${SHARK_${shark_upper}_ARCHIVE}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "SHARK_${shark_upper}_ARCHIVE SHA-256 differs from the ${name} lock")
        endif()
    elseif(FETCHCONTENT_FULLY_DISCONNECTED)
        string(TOLOWER "${name}" shark_lower)
        string(JSON shark_url GET "${shark_core_lock}" dependencies "${name}" url)
        cmake_path(GET shark_url FILENAME shark_archive_name)
        set(shark_cached_archive
            "${FETCHCONTENT_BASE_DIR}/${shark_lower}-subbuild/${shark_lower}-populate-prefix/src/${shark_archive_name}")
        if(NOT EXISTS "${shark_cached_archive}")
            message(FATAL_ERROR "Offline ${name} population requires SHARK_${shark_upper}_ARCHIVE or a previously populated locked archive cache")
        endif()
        file(SHA256 "${shark_cached_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "Cached ${name} archive SHA-256 differs from the dependency lock")
        endif()
    endif()
endfunction()

function(shark_populate_core_header_input name)
    shark_validate_core_header_input("${name}")
    string(TOUPPER "${name}" shark_upper)
    string(TOLOWER "${name}" shark_lower)
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_core_lock)
    string(JSON shark_url GET "${shark_core_lock}" dependencies "${name}" url)
    string(JSON shark_sha GET "${shark_core_lock}" dependencies "${name}" sha256)
    cmake_path(GET shark_url FILENAME shark_archive_name)
    set(shark_cached_archive
        "${FETCHCONTENT_BASE_DIR}/${shark_lower}-subbuild/${shark_lower}-populate-prefix/src/${shark_archive_name}")
    set(shark_archive "${SHARK_${shark_upper}_ARCHIVE}")
    if(shark_archive STREQUAL "" AND EXISTS "${shark_cached_archive}")
        set(shark_archive "${shark_cached_archive}")
    endif()
    if(NOT shark_archive STREQUAL "")
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "Cached ${name} archive SHA-256 differs from the dependency lock")
        endif()
        cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
        set(shark_url "${shark_archive}")
        # The disconnected profile may extract an already verified local archive;
        # no remote URL or arbitrary source override is permitted on this path.
        set(FETCHCONTENT_FULLY_DISCONNECTED OFF)
    elseif(FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline ${name} population requires SHARK_${shark_upper}_ARCHIVE or a previously populated locked archive cache")
    endif()
    FetchContent_Declare(${name}
        URL "${shark_url}"
        URL_HASH "SHA256=${shark_sha}"
        DOWNLOAD_EXTRACT_TIMESTAMP FALSE
        SOURCE_SUBDIR shark-header-only-integration
        EXCLUDE_FROM_ALL SYSTEM)
    FetchContent_MakeAvailable(${name})
    if(shark_archive STREQUAL "")
        set(shark_archive "${shark_cached_archive}")
    endif()
    set("SHARK_${name}_SOURCE_DIR" "${${shark_lower}_SOURCE_DIR}" CACHE INTERNAL "Locked ${name} source" FORCE)
    set("SHARK_${name}_ARCHIVE_INPUT" "${shark_archive}" CACHE INTERNAL "Locked ${name} archive" FORCE)
endfunction()
