cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED SHARK_GRAPH OR NOT EXISTS "${SHARK_GRAPH}")
    message(FATAL_ERROR "Missing generated Shark target graph: '${SHARK_GRAPH}'")
endif()
include("${SHARK_GRAPH}")
set(shark_tls_objects "")
foreach(shark_object IN LISTS SHARK_TLS_REVIEWED_OBJECTS)
    cmake_path(NORMAL_PATH shark_object)
    if(EXISTS "${shark_object}")
        file(REAL_PATH "${shark_object}" shark_object)
    endif()
    list(APPEND shark_tls_objects "${shark_object}")
endforeach()
if(NOT DEFINED SHARK_BOUNDARY_MODE)
    set(SHARK_BOUNDARY_MODE all)
endif()
if(NOT SHARK_BOUNDARY_MODE MATCHES "^(all|client|server)$")
    message(FATAL_ERROR "Unknown boundary mode '${SHARK_BOUNDARY_MODE}'")
endif()
set(shark_roots "")
if(NOT SHARK_BOUNDARY_MODE STREQUAL "client")
    list(APPEND shark_roots EngineCore EngineStorage Server EngineTools SceneRunner)
endif()
if(NOT SHARK_BOUNDARY_MODE STREQUAL "server")
    list(APPEND shark_roots Engine EngineClient Runtime Editor)
endif()
set(shark_checked 0)
foreach(shark_root IN LISTS shark_roots)
    if(NOT shark_root IN_LIST SHARK_GRAPH_TARGETS)
        continue()
    endif()
    math(EXPR shark_checked "${shark_checked} + 1")
    if(shark_root STREQUAL "EngineCore")
        set(shark_allowed core)
    elseif(shark_root MATCHES "^(EngineStorage|Server)$")
        set(shark_allowed core storage)
    elseif(shark_root MATCHES "^(EngineTools|SceneRunner)$")
        set(shark_allowed core authoring)
    elseif(shark_root STREQUAL "Editor")
        set(shark_allowed core client runtime authoring)
    else()
        set(shark_allowed core client runtime)
    endif()
    set(shark_pending "${shark_root}")
    set(shark_seen "")
    while(shark_pending)
        list(POP_FRONT shark_pending shark_current)
        if(shark_current IN_LIST shark_seen)
            continue()
        endif()
        list(APPEND shark_seen "${shark_current}")
        if(NOT shark_current IN_LIST SHARK_GRAPH_TARGETS)
            message(FATAL_ERROR "${shark_root} reaches unclassified dependency '${shark_current}'; classify and review this dependency explicitly")
        endif()
        if(NOT SHARK_DOMAIN_${shark_current} IN_LIST shark_allowed)
            message(FATAL_ERROR "${shark_root} reaches forbidden ${SHARK_DOMAIN_${shark_current}} target '${shark_current}'")
        endif()
        foreach(shark_property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES MANUALLY_ADDED_DEPENDENCIES)
            foreach(shark_dependency IN LISTS "SHARK_${shark_property}_${shark_current}")
                # CMake cross-directory lookup sentinels are not link items.
                if(NOT shark_dependency STREQUAL "" AND NOT shark_dependency MATCHES "^::@")
                    list(APPEND shark_pending "${shark_dependency}")
                endif()
            endforeach()
        endforeach()
        foreach(shark_property IN ITEMS LINK_DIRECTORIES INTERFACE_LINK_DIRECTORIES)
            if(NOT "${SHARK_${shark_property}_${shark_current}}" STREQUAL "")
                message(FATAL_ERROR "${shark_root} reaches unclassified linker search directory through '${shark_current}'")
            endif()
        endforeach()
        foreach(shark_property IN ITEMS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
            foreach(shark_option IN LISTS "SHARK_${shark_property}_${shark_current}")
                # The pinned Windows Vulkan loader propagates control-flow and
                # exception-continuation protection, never arbitrary LINKER items.
                if(NOT shark_option STREQUAL "" AND NOT shark_option MATCHES "^(-fsanitize=address(,undefined)?|-fno-omit-frame-pointer|/INCREMENTAL:NO|LINKER:/guard:(cf|ehcont))$")
                    message(FATAL_ERROR "${shark_root} reaches unclassified link option '${shark_option}' through '${shark_current}'")
                endif()
            endforeach()
        endforeach()
        foreach(shark_property IN ITEMS SOURCES INTERFACE_SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
            foreach(shark_path IN LISTS "SHARK_${shark_property}_${shark_current}")
                if(shark_path STREQUAL "")
                    continue()
                endif()
                if(shark_path MATCHES "\\$<")
                    message(FATAL_ERROR "${shark_root} has unevaluated ${shark_property}: '${shark_path}'")
                endif()
                cmake_path(ABSOLUTE_PATH shark_path BASE_DIRECTORY "${SHARK_SOURCE_DIR_${shark_current}}" NORMALIZE)
                if(EXISTS "${shark_path}")
                    file(REAL_PATH "${shark_path}" shark_path)
                endif()
                # Workspace/build ancestors may themselves be named tests/client.
                # Classify the path within this configure's roots, not those ancestors.
                set(shark_relative "${shark_path}")
                cmake_path(IS_PREFIX SHARK_BUILD_ROOT "${shark_path}" NORMALIZE shark_in_build)
                cmake_path(IS_PREFIX SHARK_SOURCE_ROOT "${shark_path}" NORMALIZE shark_in_source)
                if(shark_in_build)
                    cmake_path(RELATIVE_PATH shark_path BASE_DIRECTORY "${SHARK_BUILD_ROOT}" OUTPUT_VARIABLE shark_relative)
                elseif(shark_in_source)
                    cmake_path(RELATIVE_PATH shark_path BASE_DIRECTORY "${SHARK_SOURCE_ROOT}" OUTPUT_VARIABLE shark_relative)
                endif()
                string(TOLOWER "${shark_relative}" shark_path_lower)
                if(shark_property MATCHES "SOURCES$" AND shark_path_lower MATCHES "\\.(o|obj|a|lib)$")
                    if(NOT shark_current STREQUAL "SharkTLS_tfpsacrypto" OR NOT shark_path IN_LIST shark_tls_objects)
                        message(FATAL_ERROR "${shark_root} reaches unclassified prebuilt object/archive source '${shark_path}'")
                    endif()
                endif()
                set(shark_forbidden "(^|/)(editor|tests|imgui|imguizmo|cgltf|stb|dr_wav|shaderc|glslang|spirv-tools)(/|$)")
                if(shark_root STREQUAL "Editor")
                    set(shark_forbidden "(^|/)tests(/|$)")
                endif()
                if(NOT shark_root MATCHES "^(EngineTools|SceneRunner|Editor)$")
                    string(APPEND shark_forbidden "|(^|/)(engine_tools|json-src|nlohmann)(/|$)")
                endif()
                if(shark_root MATCHES "^(EngineCore|EngineStorage|Server|EngineTools|SceneRunner)$")
                    string(APPEND shark_forbidden "|(^|/)(client|runtime|glfw|nvrhi|vulkan|miniaudio|openal|sdl2|sdl3)(/|$)")
                endif()
                if(NOT shark_root MATCHES "^(EngineStorage|Server)$")
                    string(APPEND shark_forbidden "|(^|/)(server|sqlite-src)(/|$)|(^|/)sqlite3(ext)?\\.[ch]$")
                endif()
                if(shark_path_lower MATCHES "${shark_forbidden}")
                    message(FATAL_ERROR "${shark_root} reaches forbidden ${shark_property} path '${shark_path}' through '${shark_current}'")
                endif()
            endforeach()
        endforeach()
    endwhile()
    message(STATUS "${shark_root} allowed dependency closure: ${shark_seen}")
endforeach()
if(shark_checked EQUAL 0)
    message(FATAL_ERROR "No classified roots for '${SHARK_BOUNDARY_MODE}' boundary check")
endif()
