cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED SHARK_GRAPH OR NOT EXISTS "${SHARK_GRAPH}")
    message(FATAL_ERROR "Missing generated Shark target graph: '${SHARK_GRAPH}'")
endif()
include("${SHARK_GRAPH}")
foreach(shark_root IN ITEMS Engine Runtime)
    set(shark_pending "${shark_root}")
    set(shark_seen "")
    while(shark_pending)
        list(POP_FRONT shark_pending shark_current)
        if(shark_current IN_LIST shark_seen)
            continue()
        endif()
        list(APPEND shark_seen "${shark_current}")
        if(NOT shark_current IN_LIST SHARK_GRAPH_TARGETS)
            message(FATAL_ERROR "${shark_root} reaches unclassified dependency '${shark_current}'; classify and review this link explicitly")
        endif()
        if(NOT "${SHARK_DOMAIN_${shark_current}}" STREQUAL "runtime")
            message(FATAL_ERROR "${shark_root} reaches forbidden ${SHARK_DOMAIN_${shark_current}} target '${shark_current}'")
        endif()
        foreach(shark_dependency IN LISTS "SHARK_LINKS_${shark_current}")
            if(NOT shark_dependency STREQUAL "")
                list(APPEND shark_pending "${shark_dependency}")
            endif()
        endforeach()
    endwhile()
    message(STATUS "${shark_root} runtime closure: ${shark_seen}")
endforeach()
