# Source JSON belongs exclusively to EngineTools; upstream CMake never executes.
include_guard(GLOBAL)

function(shark_validate_source_document_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_json_lock)
    string(JSON shark_sha GET "${shark_json_lock}" dependencies JSON sha256)
    string(LENGTH "${shark_sha}" shark_sha_length)
    if(NOT shark_sha_length EQUAL 64 OR NOT shark_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "JSON must have an exact SHA-256 archive pin")
    endif()
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_JSON FETCHCONTENT_SOURCE_DIR_NLOHMANN_JSON
            nlohmann_json_DIR JSON_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified JSON source override ${shark_override}; use SHARK_JSON_ARCHIVE")
        endif()
    endforeach()
    string(JSON shark_version GET "${shark_json_lock}" dependencies JSON version)
    set(SHARK_JSON_ARCHIVE "" CACHE FILEPATH "Optional exact locked nlohmann/json release archive")
    set(shark_archive "${SHARK_JSON_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/json-${shark_version}.tar.xz")
    endif()
    if(EXISTS "${shark_archive}")
        if(IS_DIRECTORY "${shark_archive}" OR IS_SYMLINK "${shark_archive}")
            message(FATAL_ERROR "SHARK_JSON_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "JSON archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_JSON_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline JSON population requires SHARK_JSON_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_source_document_dependencies)
    shark_validate_source_document_inputs()
    if(TARGET nlohmann_json OR TARGET nlohmann_json::nlohmann_json)
        message(FATAL_ERROR "JSON target already exists outside the reviewed authoring integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_json_lock)
    string(JSON shark_sha GET "${shark_json_lock}" dependencies JSON sha256)
    string(JSON shark_url GET "${shark_json_lock}" dependencies JSON url)
    string(JSON shark_version GET "${shark_json_lock}" dependencies JSON version)
    set(shark_archive "${SHARK_JSON_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/json-${shark_version}.tar.xz")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(NOT EXISTS "${shark_archive}")
        file(DOWNLOAD "${shark_url}" "${shark_archive}" EXPECTED_HASH "SHA256=${shark_sha}"
            TLS_VERIFY ON TIMEOUT 60 STATUS shark_download)
        list(GET shark_download 0 shark_download_code)
        if(NOT shark_download_code EQUAL 0)
            message(FATAL_ERROR "Locked JSON download failed: ${shark_download}")
        endif()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/source_document_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}"
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked JSON source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_json_source "${CMAKE_BINARY_DIR}/_deps/json-src")
    set(SHARK_JSON_SOURCE_DIR "${shark_json_source}" CACHE INTERNAL "Locked source JSON directory" FORCE)
    set(SHARK_JSON_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked source JSON archive" FORCE)
    add_library(nlohmann_json INTERFACE)
    add_library(nlohmann_json::nlohmann_json ALIAS nlohmann_json)
    target_include_directories(nlohmann_json SYSTEM INTERFACE "${shark_json_source}/include")
    target_compile_features(nlohmann_json INTERFACE cxx_std_20)
    target_compile_definitions(nlohmann_json INTERFACE
        JSON_USE_IMPLICIT_CONVERSIONS=0 JSON_USE_LEGACY_DISCARDED_VALUE_COMPARISON=0)
    shark_classify_target(nlohmann_json authoring)
    shark_classify_target(nlohmann_json::nlohmann_json authoring)
endfunction()
