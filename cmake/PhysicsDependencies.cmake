# Jolt is a private, pinned CPU-only Core implementation dependency.
include_guard(GLOBAL)

function(shark_validate_physics_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_physics_lock)
    string(JSON shark_sha GET "${shark_physics_lock}" dependencies Jolt sha256)
    string(JSON shark_commit GET "${shark_physics_lock}" dependencies Jolt commit)
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_JOLT JOLT_PHYSICS_ROOT PHYSICS_REPO_ROOT)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified physics source override ${shark_override}; use SHARK_JOLT_ARCHIVE")
        endif()
    endforeach()
    set(SHARK_JOLT_ARCHIVE "" CACHE FILEPATH "Optional exact locked Jolt archive")
    set(shark_archive "${SHARK_JOLT_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_canonical "${PROJECT_SOURCE_DIR}/out/dependency-cache/jolt-${shark_commit}.tar.gz")
        if(EXISTS "${shark_canonical}")
            set(shark_archive "${shark_canonical}")
        else()
            set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/jolt-${shark_commit}.tar.gz")
        endif()
    endif()
    if(EXISTS "${shark_archive}")
        if(IS_DIRECTORY "${shark_archive}" OR IS_SYMLINK "${shark_archive}")
            message(FATAL_ERROR "SHARK_JOLT_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "Jolt archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_JOLT_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline Jolt population requires SHARK_JOLT_ARCHIVE or its prior locked archive cache")
    endif()
    set(SHARK_JOLT_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked Jolt archive" FORCE)
endfunction()

function(shark_setup_physics_dependencies)
    shark_validate_physics_inputs()
    if(TARGET Jolt OR TARGET Jolt::Jolt OR TARGET SharkPhysics_jolt)
        message(FATAL_ERROR "Jolt target already exists outside the reviewed Core integration")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(shark_download_argument)
    if(NOT EXISTS "${SHARK_JOLT_ARCHIVE_INPUT}")
        if(FETCHCONTENT_FULLY_DISCONNECTED)
            message(FATAL_ERROR "Disconnected Jolt configure requires its locked archive")
        endif()
        set(shark_download_argument --download)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/physics_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${SHARK_JOLT_ARCHIVE_INPUT}" ${shark_download_argument}
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output
        ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked Jolt source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_physics_source "${CMAKE_BINARY_DIR}/_deps/jolt-src")
    set(SHARK_JOLT_SOURCE_DIR "${shark_physics_source}" CACHE INTERNAL "Locked Jolt source" FORCE)
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_physics_lock)
    string(JSON shark_option_count LENGTH "${shark_physics_lock}" dependencies Jolt options)
    math(EXPR shark_option_last "${shark_option_count} - 1")
    foreach(shark_index RANGE ${shark_option_last})
        string(JSON shark_option MEMBER "${shark_physics_lock}" dependencies Jolt options ${shark_index})
        string(JSON shark_value GET "${shark_physics_lock}" dependencies Jolt options "${shark_option}")
        # Normal scoped variables honor CMP0077 without changing sibling projects.
        set(${shark_option} "${shark_value}")
    endforeach()
    find_package(Threads REQUIRED)
    set_property(TARGET Threads::Threads PROPERTY IMPORTED_GLOBAL TRUE)
    shark_classify_target(Threads::Threads core)
    add_subdirectory("${shark_physics_source}/Build" "${CMAKE_BINARY_DIR}/_deps/jolt-build" EXCLUDE_FROM_ALL SYSTEM)
    set_target_properties(Jolt PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO
        DISABLE_PRECOMPILE_HEADERS ON UNITY_BUILD OFF INTERPROCEDURAL_OPTIMIZATION OFF)
    if(MSVC)
        set_property(TARGET Jolt PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
    # Upstream's sole Unix raw link flag is replaced with the classified thread
    # target. Keep CPU compile flags private to Jolt and its Core consumer.
    foreach(shark_property IN ITEMS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
        get_target_property(shark_links Jolt ${shark_property})
        if(shark_links AND NOT shark_links STREQUAL "-pthread")
            message(FATAL_ERROR "Unreviewed Jolt link options: ${shark_links}")
        endif()
        set_property(TARGET Jolt PROPERTY ${shark_property} "")
    endforeach()
    target_link_libraries(Jolt PUBLIC Threads::Threads)
    shark_enable_sanitizers(Jolt)
    add_library(SharkPhysics_jolt ALIAS Jolt)
    foreach(shark_target IN ITEMS Jolt Jolt::Jolt SharkPhysics_jolt)
        shark_classify_target(${shark_target} core)
    endforeach()
    if(SHARK_BUILD_SERVER)
        install(FILES "${shark_physics_source}/LICENSE" DESTINATION licenses/Jolt COMPONENT Server)
    endif()
endfunction()
