# SQLite's reviewed amalgamation belongs exclusively to Server storage.
include_guard(GLOBAL)

function(shark_validate_storage_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_storage_lock)
    string(JSON shark_sha GET "${shark_storage_lock}" dependencies SQLite sha256)
    string(JSON shark_prefix GET "${shark_storage_lock}" dependencies SQLite archive_prefix)
    foreach(shark_override IN ITEMS FETCHCONTENT_SOURCE_DIR_SQLITE SQLite3_DIR SQLite3_INCLUDE_DIR SQLite3_LIBRARY SQLITE_SOURCE_DIR)
        if(DEFINED ${shark_override} AND NOT "${${shark_override}}" STREQUAL "")
            message(FATAL_ERROR "Unverified SQLite source override ${shark_override}; use SHARK_SQLITE_ARCHIVE")
        endif()
    endforeach()
    set(SHARK_SQLITE_ARCHIVE "" CACHE FILEPATH "Optional exact locked SQLite amalgamation archive")
    set(shark_archive "${SHARK_SQLITE_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/${shark_prefix}.zip")
    endif()
    if(EXISTS "${shark_archive}")
        if(IS_DIRECTORY "${shark_archive}" OR IS_SYMLINK "${shark_archive}")
            message(FATAL_ERROR "SHARK_SQLITE_ARCHIVE must name a regular locked archive")
        endif()
        file(SHA256 "${shark_archive}" shark_actual_sha)
        if(NOT shark_actual_sha STREQUAL shark_sha)
            message(FATAL_ERROR "SQLite archive SHA-256 differs from the dependency lock")
        endif()
    elseif(NOT SHARK_SQLITE_ARCHIVE STREQUAL "" OR FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR "Offline SQLite population requires SHARK_SQLITE_ARCHIVE or its prior locked archive cache")
    endif()
endfunction()

function(shark_setup_storage_dependencies)
    shark_validate_storage_inputs()
    if(TARGET SharkSQLite)
        message(FATAL_ERROR "SQLite target already exists outside reviewed Server storage integration")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_storage_lock)
    string(JSON shark_sha GET "${shark_storage_lock}" dependencies SQLite sha256)
    string(JSON shark_url GET "${shark_storage_lock}" dependencies SQLite url)
    string(JSON shark_prefix GET "${shark_storage_lock}" dependencies SQLite archive_prefix)
    set(shark_archive "${SHARK_SQLITE_ARCHIVE}")
    if(shark_archive STREQUAL "")
        set(shark_archive "${CMAKE_BINARY_DIR}/shark-dependency-archives/${shark_prefix}.zip")
    endif()
    cmake_path(ABSOLUTE_PATH shark_archive BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE)
    if(NOT EXISTS "${shark_archive}")
        file(DOWNLOAD "${shark_url}" "${shark_archive}" EXPECTED_HASH "SHA256=${shark_sha}"
            TLS_VERIFY ON TIMEOUT 60 STATUS shark_download)
        list(GET shark_download 0 shark_download_code)
        if(NOT shark_download_code EQUAL 0)
            message(FATAL_ERROR "Locked SQLite download failed: ${shark_download}")
        endif()
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/storage_dependency.py"
        --build "${CMAKE_BINARY_DIR}" --archive "${shark_archive}"
        RESULT_VARIABLE shark_population_status OUTPUT_VARIABLE shark_population_output ERROR_VARIABLE shark_population_error)
    if(NOT shark_population_status EQUAL 0)
        message(FATAL_ERROR "Locked SQLite source verification failed: ${shark_population_output}${shark_population_error}")
    endif()
    set(shark_source "${CMAKE_BINARY_DIR}/_deps/sqlite-src")
    set(SHARK_SQLITE_SOURCE_DIR "${shark_source}" CACHE INTERNAL "Locked SQLite source" FORCE)
    set(SHARK_SQLITE_ARCHIVE_INPUT "${shark_archive}" CACHE INTERNAL "Locked SQLite archive" FORCE)
    add_library(SharkSQLite STATIC "${shark_source}/sqlite3.c")
    target_include_directories(SharkSQLite SYSTEM PUBLIC "${shark_source}")
    string(JSON shark_count LENGTH "${shark_storage_lock}" dependencies SQLite compile_definitions)
    math(EXPR shark_last "${shark_count} - 1")
    foreach(shark_index RANGE ${shark_last})
        string(JSON shark_definition GET "${shark_storage_lock}" dependencies SQLite compile_definitions ${shark_index})
        target_compile_definitions(SharkSQLite PRIVATE "${shark_definition}")
    endforeach()
    target_link_libraries(SharkSQLite PRIVATE Threads::Threads)
    shark_enable_sanitizers(SharkSQLite)
    shark_classify_target(SharkSQLite storage)
    install(FILES "${shark_source}/LICENSE.txt" DESTINATION licenses/SQLite COMPONENT Server)
endfunction()
