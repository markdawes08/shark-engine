# GLM is the documented public math exception, configured through SharkMath only.
include_guard(GLOBAL)
include(CoreHeaderDependencies)

function(shark_validate_math_inputs)
    shark_validate_core_header_input(GLM)
endfunction()

function(shark_setup_math_dependencies)
    if(TARGET SharkMath OR TARGET glm OR TARGET glm::glm)
        message(FATAL_ERROR "GLM target already exists outside the reviewed Core integration")
    endif()
    shark_populate_core_header_input(GLM)
    if(NOT EXISTS "${SHARK_GLM_SOURCE_DIR}/glm/glm.hpp"
            OR NOT EXISTS "${SHARK_GLM_SOURCE_DIR}/copying.txt")
        message(FATAL_ERROR "Locked GLM source is incomplete")
    endif()
    add_library(SharkMath INTERFACE)
    target_include_directories(SharkMath SYSTEM INTERFACE "${SHARK_GLM_SOURCE_DIR}")
    target_compile_features(SharkMath INTERFACE cxx_std_20)
    file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" shark_math_lock)
    string(JSON shark_definition_count LENGTH "${shark_math_lock}" dependencies GLM compile_definitions)
    math(EXPR shark_definition_last "${shark_definition_count} - 1")
    foreach(shark_index RANGE ${shark_definition_last})
        string(JSON shark_definition GET "${shark_math_lock}" dependencies GLM compile_definitions ${shark_index})
        target_compile_definitions(SharkMath INTERFACE "${shark_definition}")
    endforeach()
    shark_classify_target(SharkMath core)
    if(SHARK_BUILD_SERVER)
        install(FILES "${SHARK_GLM_SOURCE_DIR}/copying.txt" DESTINATION licenses/GLM COMPONENT Server)
    endif()
endfunction()
