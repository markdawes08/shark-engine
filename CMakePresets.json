{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SHARK_BUILD_EDITOR": "ON",
        "SHARK_BUILD_TESTS": "ON",
        "SHARK_INJECT_TEST_FAILURE": "OFF",
        "SHARK_SANITIZER": "none",
        "SHARK_BUILD_CLIENT": "ON",
        "SHARK_BUILD_SERVER": "ON",
        "SHARK_BUILD_GRAPHICS_PROBE": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "displayName": "windows debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "displayName": "windows release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-asan",
      "inherits": "base",
      "displayName": "windows asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SHARK_SANITIZER": "address"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "displayName": "linux debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "linux release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "inherits": "base",
      "displayName": "linux asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "SHARK_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "runtime-only",
      "inherits": "base",
      "displayName": "Host-native runtime boundary build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_TESTS": "OFF",
        "SHARK_BUILD_SERVER": "OFF"
      }
    },
    {
      "name": "server-only",
      "inherits": "base",
      "displayName": "Headless server-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SHARK_BUILD_CLIENT": "OFF",
        "SHARK_BUILD_SERVER": "ON",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_TESTS": "OFF",
        "SHARK_SANITIZER": "none",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON"
      }
    },
    {
      "name": "server-debug",
      "inherits": "base",
      "displayName": "Headless server-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHARK_BUILD_CLIENT": "OFF",
        "SHARK_BUILD_SERVER": "ON",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_TESTS": "ON",
        "SHARK_SANITIZER": "none"
      }
    },
    {
      "name": "server-asan-ubsan",
      "inherits": "base",
      "displayName": "Headless server-asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHARK_BUILD_CLIENT": "OFF",
        "SHARK_BUILD_SERVER": "ON",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_TESTS": "ON",
        "SHARK_SANITIZER": "address-undefined",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "graphics-windows",
      "inherits": "windows-debug",
      "displayName": "Opt-in windows graphics feasibility probe",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "SHARK_BUILD_GRAPHICS_PROBE": "ON",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_SERVER": "OFF"
      }
    },
    {
      "name": "graphics-windows-release",
      "inherits": "graphics-windows",
      "displayName": "Release Windows graphics probe for standalone packaging",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "graphics-linux",
      "inherits": "linux-debug",
      "displayName": "Opt-in linux graphics feasibility probe",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "SHARK_BUILD_GRAPHICS_PROBE": "ON",
        "SHARK_BUILD_EDITOR": "OFF",
        "SHARK_BUILD_SERVER": "OFF"
      }
    },
    {
      "name": "graphics-linux-release",
      "inherits": "graphics-linux",
      "displayName": "Release Linux graphics probe for standalone packaging",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SKIP_RPATH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "runtime-only",
      "configurePreset": "runtime-only"
    },
    {
      "name": "server-only",
      "configurePreset": "server-only"
    },
    {
      "name": "server-debug",
      "configurePreset": "server-debug"
    },
    {
      "name": "server-asan-ubsan",
      "configurePreset": "server-asan-ubsan"
    },
    {
      "name": "graphics-windows",
      "configurePreset": "graphics-windows"
    },
    {
      "name": "graphics-windows-release",
      "configurePreset": "graphics-windows-release"
    },
    {
      "name": "graphics-linux",
      "configurePreset": "graphics-linux"
    },
    {
      "name": "graphics-linux-release",
      "configurePreset": "graphics-linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1"
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "server-debug",
      "configurePreset": "server-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "server-asan-ubsan",
      "configurePreset": "server-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "graphics-windows",
      "configurePreset": "graphics-windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "graphics-windows-release",
      "configurePreset": "graphics-windows-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "graphics-linux",
      "configurePreset": "graphics-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "graphics-linux-release",
      "configurePreset": "graphics-linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/graphics-linux-release/bin"
      }
    }
  ]
}
